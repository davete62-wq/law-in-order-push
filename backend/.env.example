# 
# .env.example  Copy this to .env and fill in your values.
# NEVER commit your real .env file to GitHub.
# 

# Your PostgreSQL connection string from Neon or Supabase
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# A long random secret used to sign session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string

# How many hours a login session lasts before the user is logged out.
SESSION_HOURS=24

# Cloudinary credentials for file uploads (free tier is fine).
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# The URL of your deployed frontend so CORS is configured correctly.
# During local dev you can use: http://localhost:5500
# After deploying to GitHub Pages: https://yourusername.github.io/law-in-order
FRONTEND_URL=https://yourusername.github.io/law-in-order

# Max file upload size in megabytes
MAX_UPLOAD_MB=20
